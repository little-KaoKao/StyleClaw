# =============================================================================
# StyleClaw 环境变量
# 用法：cp .env.example .env，填好 [必需] 4 个就能跑。其余可选，详见 CLAUDE.md。
# =============================================================================


# =============================================================================
# [必需]
# =============================================================================
RUNNINGHUB_API_KEY=<your-runninghub-api-key>
OPENAI_COMPAT_API_KEY=<your-llm-provider-api-key>
OPENAI_COMPAT_BASE_URL=https://api.gptproto.com/v1
# 所有 LLM 角色未单独配置时的默认 model id
LLM_MODEL=gemini-3.1-pro-preview


# =============================================================================
# [存储 & 日志]
# =============================================================================
# STYLECLAW_DATA_ROOT=data/projects       # 项目数据根目录
# STYLECLAW_LOG_LEVEL=INFO                # 临时调 DEBUG 用 CLI 的 -v
# STYLECLAW_SKIP_ENV_CHECK=1              # 离线工具时跳过启动校验


# =============================================================================
# [并发]   日常无需调整
# =============================================================================
# 图像生成并发上限；上调要确认 RunningHub 套餐能扛住
STYLECLAW_CONCURRENCY=10
# LLM 并发上限；太高会 gateway 429
STYLECLAW_LLM_CONCURRENCY=4
# STYLECLAW_IMAGE_ENCODE_CONCURRENCY=8    # 本地图片编码
# STYLECLAW_DOWNLOAD_CONCURRENCY=8        # 结果图下载


# =============================================================================
# [超时 & 轮询]   网络/上行慢时往大调
# =============================================================================
# 慢上行链路报 WriteTimeout 时把 WRITE 调到 600+
# STYLECLAW_LLM_WRITE_TIMEOUT=300
# STYLECLAW_LLM_READ_TIMEOUT=300
# STYLECLAW_LLM_CONNECT_TIMEOUT=30
# STYLECLAW_RH_TIMEOUT=60
# STYLECLAW_RH_CONNECT_TIMEOUT=30
# STYLECLAW_TASK_TIMEOUT=300              # 单任务轮询超时
# STYLECLAW_POLL_INTERVAL=3               # 单任务轮询间隔
# STYLECLAW_POLL_MAX_CONSEC_FAIL=5        # 连续失败几次就放弃
# STYLECLAW_ORCH_POLL_INTERVAL=30         # 编排器外层周期
# STYLECLAW_MAX_POLL_CYCLES=60            # 编排器最大周期数 (默认 = 30 分钟)
# STYLECLAW_MAX_DOWNLOAD_BYTES=52428800   # 单张图下载硬上限 (50MB)
# STYLECLAW_MAX_ROUNDS=5                  # STYLE_REFINE 自动 refine 轮数上限


# =============================================================================
# [Per-role 模型路由]
# 4 个角色：vision_critic(打分) / vision_analyst(看图) / writer(写用例) / planner(意图→ActionPlan)
# 注释掉 = 回退到 LLM_MODEL。常见用法：vision_analyst 用强视觉模型，planner 用便宜模型。
# =============================================================================
# STYLECLAW_MODEL_VISION_CRITIC=gemini-3.1-pro-preview
# STYLECLAW_MODEL_VISION_ANALYST=claude-opus-4-6-thinking
# STYLECLAW_MODEL_WRITER=claude-sonnet-4-6
# STYLECLAW_MODEL_PLANNER=claude-haiku-4-5-20251001


# =============================================================================
# [Panel 三模合议]   花 ~3-9x token 换更稳的输出
# 3 个模型并行出方案 + 交叉打分(不自评) + 选胜者。
# 只 analyze / model-select-evaluate / refine 这 3 个动作支持 panel。
# =============================================================================
# 开关：truthy = 1/true/yes/on
# STYLECLAW_PANEL_ANALYZE=1               # INIT 的 analyze (vision_analyst)
# STYLECLAW_PANEL_MODEL_SELECT=1          # MODEL_SELECT 的 evaluate (vision_critic)
# STYLECLAW_PANEL_REFINE=1                # STYLE_REFINE 的 refine (vision_analyst)
# 全局池 (任一 toggle 开启时必填) —— 3 个逗号分隔 model id
# STYLECLAW_PANEL_MODELS=gemini-3.1-pro-preview,gpt-5.4,claude-opus-4-6-thinking
# STYLECLAW_PANEL_LABELS=Gemini,GPT,Claude    # 报告里展示的标签
# 按角色独立配池 (优先级高于全局)
# STYLECLAW_PANEL_MODELS_VISION_CRITIC=...
# STYLECLAW_PANEL_MODELS_VISION_ANALYST=...
# STYLECLAW_ALLOW_DEGRADED_PANEL=1        # 降级时仍持久化 (默认拒绝)


# =============================================================================
# [其它调优]
# =============================================================================
# design_cases 并行分片数；必须能整除 10 个分类 (允许: 1/2/5/10)
# STYLECLAW_DESIGN_CASES_SHARDS=5
# LLM 响应流式打印；TTY 自动开，pipe/CI 自动关
# STYLECLAW_STREAM_DISPLAY=1
# 图片 resize/encode 磁盘缓存 (位置: DATA_ROOT/.cache/llm-images/)
# STYLECLAW_LLM_IMAGE_CACHE=1
