# =============================================================================
# StyleClaw 环境变量配置
# =============================================================================
#
# 用法：cp .env.example .env，然后填写 [必需] 段的 4 个变量即可启动。
# 其它分段全部为可选调优，留空注释即用默认值。
#
# -----------------------------------------------------------------------------
# 项目速览 —— 后文注释会用到这些术语，先一次性说清楚：
#
#   5 个阶段（state machine）：
#     INIT → MODEL_SELECT → STYLE_REFINE → BATCH_T2I → BATCH_I2I → COMPLETED
#
#   4 个 LLM 角色（每个角色独立配置 model_id 与 panel 池）：
#     vision_critic   —— 给生成图打分，用于 MODEL_SELECT 的 select-model
#                        与 STYLE_REFINE 的 evaluate
#     vision_analyst  —— 看参考图写/改触发词，用于 INIT 的 analyze
#                        与 STYLE_REFINE 的 refine
#     writer          —— 写 100 条测试用例描述，用于 BATCH_T2I 的 design-cases
#     planner         —— 把自然语言意图转为 ActionPlan，用于 styleclaw run
#
#   Panel 模式（三模合议）：上面的某些阶段可切换为「3 个模型并行出方案 +
#     交叉打分（不自评）+ 选胜者」。更贵但更稳，详见 [Panel 三模合议] 段。
# =============================================================================


# =============================================================================
# [必需]   不填这 4 个就跑不起来
# =============================================================================

# RunningHub 图像生成 API Key
RUNNINGHUB_API_KEY=<your-runninghub-api-key>

# OpenAI 兼容的 LLM provider（如 gptproto.com、openrouter 等）
OPENAI_COMPAT_API_KEY=<your-llm-provider-api-key>
OPENAI_COMPAT_BASE_URL=https://api.gptproto.com/v1

# 默认 LLM model id。所有 4 个角色未单独配置时都回退到它。
LLM_MODEL=gemini-3.1-pro-preview


# =============================================================================
# [存储 & 日志]
# =============================================================================

# 项目数据根目录。所有 project 状态、生成图、报告都落在这里。
# 默认: data/projects
# STYLECLAW_DATA_ROOT=data/projects

# 根 logger 等级。临时调 DEBUG 用 CLI 的 --verbose / -v 即可，不必改这个。
# 默认: INFO
# STYLECLAW_LOG_LEVEL=INFO

# 设为 1/true 跳过 CLI 启动时的环境变量校验。
# 只在离线工具或不需要 API key 的本地操作时打开。
# 默认: unset
# STYLECLAW_SKIP_ENV_CHECK=1


# =============================================================================
# [并发]   控制同时发出去的请求数
# =============================================================================

# RunningHub 图像生成的并发上限（asyncio semaphore）。
# 走批量 t2i/i2i 100 任务时这个值决定提交速度；
# 上调要确认你的 RunningHub 套餐能扛住，否则会触发限流。
# 默认: 10
STYLECLAW_CONCURRENCY=10

# LLM 并发上限。evaluate / panel 模式会同时发多个带图请求，
# 太高容易在 gateway 端 429；想加速 design_cases 优先调 SHARDS（见下）。
# 默认: 4
STYLECLAW_LLM_CONCURRENCY=4

# 本地图片编码（resize + base64）并发上限。
# 仅当观察到 CPU 编码成为瓶颈时再调。
# 默认: 8
# STYLECLAW_IMAGE_ENCODE_CONCURRENCY=8

# 结果图下载并发上限。100 任务 × 4 张图 = 400 个 URL，
# 默认 8 是为了避免压垮共享 CDN 的连接池。
# 默认: 8
# STYLECLAW_DOWNLOAD_CONCURRENCY=8


# =============================================================================
# [超时 & 轮询]   网络慢、或上传链路差时往大调
# =============================================================================

# LLM 请求 httpx 超时（秒）。evaluate / panel 会同时上传几十张 base64 图，
# 慢上行链路常见的报错是 WriteTimeout —— 这时把 WRITE 调到 600 以上。
# 默认: 300 / 300 / 30
# STYLECLAW_LLM_WRITE_TIMEOUT=300
# STYLECLAW_LLM_READ_TIMEOUT=300
# STYLECLAW_LLM_CONNECT_TIMEOUT=30

# RunningHub 客户端 httpx 超时（秒）。
# 提交/查询都是小 JSON，主要覆盖 RunningHub 队列侧延迟。
# 默认: 60 / 30
# STYLECLAW_RH_TIMEOUT=60
# STYLECLAW_RH_CONNECT_TIMEOUT=30

# 单任务轮询超时（秒）。任务在 RunningHub 跑超这个值就当 FAIL。
# 默认: 300
# STYLECLAW_TASK_TIMEOUT=300

# 单任务轮询间隔（秒，前 3 次后会指数退避）。
# 默认: 3
# STYLECLAW_POLL_INTERVAL=3

# 单任务连续轮询失败多少次就放弃。
# 默认: 5
# STYLECLAW_POLL_MAX_CONSEC_FAIL=5

# 编排器外层轮询周期（秒）—— styleclaw poll 多久检查一次整体进度。
# 默认: 30
# STYLECLAW_ORCH_POLL_INTERVAL=30

# 编排器最多轮询多少个周期就报 timeout（保护用，不会无限等）。
# 默认: 60   （配合默认 30s 周期 = 30 分钟上限）
# STYLECLAW_MAX_POLL_CYCLES=60

# 单张图下载体积硬上限（字节，超过中途中止）。默认 50MB。
# 默认: 52428800
# STYLECLAW_MAX_DOWNLOAD_BYTES=52428800

# STYLE_REFINE 阶段最多自动跑多少轮 refine。
# 到顶后需要手动 approve 或 retest-models 才能继续。
# 默认: 5
# STYLECLAW_MAX_ROUNDS=5


# =============================================================================
# [Per-role 模型路由]   让不同角色用不同模型，注释掉就回退到 LLM_MODEL
# =============================================================================
#
# 角色职责见顶部「项目速览」。常见组合：让 vision_analyst 用强视觉模型
# （Opus / Gemini Pro），让 planner 用便宜模型（Haiku）省钱。
#
# 默认全部 unset（= 全部使用 LLM_MODEL）

# STYLECLAW_MODEL_VISION_CRITIC=gemini-3.1-pro-preview
# STYLECLAW_MODEL_VISION_ANALYST=claude-opus-4-6-thinking
# STYLECLAW_MODEL_WRITER=claude-sonnet-4-6
# STYLECLAW_MODEL_PLANNER=claude-haiku-4-5-20251001


# =============================================================================
# [Panel 三模合议]   花 ~3-9x token 换更稳的输出
# =============================================================================
#
# 什么时候开：单模型的 analyze / evaluate / refine 在你的 IP 上不稳定，
#   或想消除"被某个模型的偏好绑架"的风险时。日常迭代不需要开。
#
# 工作流程：3 个模型并行出方案 → 互相打分（不自评，避免自吹）
#   → 取均分最高的为 winner → 落到原本的 artifact（无需改下游）。
#
# 注意：只有 analyze / model-select 的 evaluate / refine 这 3 个动作有
# panel 分支，其余 LLM 调用点（STYLE_REFINE 的 evaluate、design_cases、
# planner）即使开了 toggle 也仍走单模型。

# 开关：truthy = "1" / "true" / "yes" / "on"
# 默认全部 OFF
# STYLECLAW_PANEL_MODEL_SELECT=1   # → MODEL_SELECT 的 evaluate（vision_critic 池）
# STYLECLAW_PANEL_REFINE=1         # → STYLE_REFINE 的 refine（vision_analyst 池）
# STYLECLAW_PANEL_ANALYZE=1        # → INIT 的 analyze（vision_analyst 池）

# 全局 panel 池（任何 panel toggle 开启 + 该角色未单独配池时使用）。
# 必须是 3 个逗号分隔的 model id。
# 默认: unset（开启 panel 时必填，否则启动会报错）
# STYLECLAW_PANEL_MODELS=gemini-3.1-pro-preview,gpt-5.4,claude-opus-4-6-thinking

# 报告/日志里展示的人类可读标签（数量必须与 PANEL_MODELS 一致）。
# 默认: 沿用 model id
# STYLECLAW_PANEL_LABELS=Gemini,GPT,Claude

# 按角色独立配池（优先级高于全局 STYLECLAW_PANEL_MODELS）。
# vision_analyst 池同时给 analyze + refine 用。
# 默认: 都 unset（回退到 STYLECLAW_PANEL_MODELS）
# STYLECLAW_PANEL_MODELS_VISION_CRITIC=gemini-3.1-pro-preview,gpt-5.4,claude-opus-4-6-thinking
# STYLECLAW_PANEL_MODELS_VISION_ANALYST=gemini-3.1-pro-preview,gpt-5.4,claude-opus-4-6-thinking

# Panel 运行降级时（某个提议者/打分者失败、或无人胜出），
# 默认拒绝持久化结果以防 bogus winner 污染下游。
# 设为 truthy 允许保存降级结果（用于排查/取证）。
# 默认: unset
# STYLECLAW_ALLOW_DEGRADED_PANEL=1


# =============================================================================
# [其它调优]
# =============================================================================

# design_cases 并行分片数。每片生成 100/N 条用例。
# 允许值: 1, 2, 5, 10  （必须能整除固定的 10 个分类）
# 调大 = 更并行 + 每片 token 预算更小（降低 429 / 500 风险），
# 调小 = 总 system-prompt 开销小 + 但单次 LLM 请求更大。
# 默认: 5
# STYLECLAW_DESIGN_CASES_SHARDS=5

# LLM 响应增量是否流式打印到 stdout（"  ↓ ..." 那种）。
# 默认: TTY 自动开，pipe/CI 自动关。设为 0 强制关。
# 默认: 1（仅 TTY）
# STYLECLAW_STREAM_DISPLAY=1

# 是否启用本地 resize/encode 后的图片磁盘缓存
# （位置：DATA_ROOT/.cache/llm-images/）。
# 默认: 1
# STYLECLAW_LLM_IMAGE_CACHE=1
