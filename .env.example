# 两个并发独立配置：
STYLECLAW_CONCURRENCY=10
STYLECLAW_LLM_CONCURRENCY=6

RUNNINGHUB_API_KEY=<your-runninghub-api-key>

# --- LLM Provider: choose ONE block ---

# Option A: OpenAI-compatible (gptproto.com, etc.) — takes priority if set
OPENAI_COMPAT_API_KEY=<your-gptproto-api-key>
OPENAI_COMPAT_BASE_URL=https://api.gptproto.com/v1
LLM_MODEL=gemini-3.1-pro-preview

# Option B: AWS Bedrock (legacy)
# AWS_REGION=us-east-1
# AWS_BEARER_TOKEN_BEDROCK=<your-bedrock-token>
# LLM_MODEL=anthropic.claude-sonnet-4-20250514

# Option C: RunningHub LLM (OpenAI-compatible, same key as image API)
# RUNNINGHUB_LLM=1
# RUNNINGHUB_LLM_BASE_URL=https://llm.runninghub.cn/v1
# LLM_MODEL=rh-llm-a/rh-c-o-47
# RUNNINGHUB_LLM_REASONING_EFFORT=high

